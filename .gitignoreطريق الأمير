<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>طريق الأمير</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{background:#000;color:#fff;font-family:-apple-system,BlinkMacSystemFont,sans-serif;overscroll-behavior:none}
.app{max-width:440px;margin:0 auto;min-height:100vh;background:#000;position:relative;padding-bottom:30px}
.header{position:sticky;top:0;z-index:100;background:rgba(0,0,0,.98);backdrop-filter:blur(20px);padding:14px 16px;border-bottom:1px solid #1a1a1a;display:flex;align-items:center;justify-content:space-between;min-height:64px}
.h-left{display:flex;align-items:center;gap:10px}
.h-logo{width:42px;height:42px;background:linear-gradient(135deg,#fbbf24,#d97706);border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;color:#000;font-size:18px;box-shadow:0 0 20px rgba(251,191,36,.3)}
.h-title{font-size:22px;font-weight:800;background:linear-gradient(180deg,#fde68a,#fbbf24 50%,#d97706);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.lang-btn{width:44px;height:44px;background:#0f0f0f;border:2px solid #fbbf24;border-radius:12px;color:#fbbf24;font-weight:800;font-size:13px;cursor:pointer;display:flex;align-items:center;justify-content:center}

.counter{position:sticky;top:64px;z-index:90;background:rgba(0,0,0,.9);backdrop-filter:blur(12px);padding:8px 16px;font-size:12px;color:#888;border-bottom:1px solid #111;display:flex;justify-content:space-between;align-items:center}
.counter b{color:#fbbf24;font-weight:700}

.content{padding:12px}
.filters{display:flex;gap:6px;padding:6px 0 14px;overflow-x:auto;scrollbar-width:none}
.filters::-webkit-scrollbar{display:none}
.chip{padding:8px 16px;background:#0a0a0a;border:1px solid #1a1a1a;border-radius:16px;font-size:12px;color:#777;white-space:nowrap;cursor:pointer;flex-shrink:0;font-weight:500;transition:.2s}
.chip.active{background:#fbbf24;color:#000;border-color:#fbbf24;font-weight:700}

.card{background:linear-gradient(180deg,#0e0e0e,#0a0a0a);border:1px solid #1a1a1a;border-radius:20px;padding:17px;margin-bottom:12px;position:relative;overflow:hidden;transition:.2s}
.card::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.08),transparent)}
.learn-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:15px}
.cn-char{font-size:42px;font-weight:700;background:linear-gradient(180deg,#fde68a,#fbbf24 60%,#d97706);-webkit-background-clip:text;-webkit-text-fill-color:transparent;line-height:1.1}
.cn-py{font-size:14px;color:#888;margin-top:5px;font-family:ui-monospace,monospace}
.play-btn{width:50px;height:50px;background:linear-gradient(135deg,#111,#0a0a0a);border:1px solid #222;border-radius:13px;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;transition:.15s}
.play-btn:active{transform:scale(.9)}
.play-btn svg{width:20px;height:20px;fill:#fbbf24}
.play-btn.playing{background:linear-gradient(135deg,#fbbf24,#f59e0b);border-color:#fbbf24}
.play-btn.playing svg{fill:#000}

.lang-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px}
.lang-box{background:#000;border:1px solid #161616;border-radius:14px;padding:12px 8px;text-align:center}
.lang-label{display:block;font-size:10px;color:#555;margin-bottom:4px;font-weight:600;letter-spacing:.5px}
.lang-val{font-size:16px;font-weight:700;line-height:1.2}
.lang-box.en .lang-val{color:#7dd3fc}
.lang-box.ar .lang-val{color:#fcd34d}

.result-box{background:linear-gradient(180deg,rgba(5,30,18,.8),rgba(2,15,9,.95));border:1px solid rgba(16,185,129,.2);border-radius:14px;padding:12px;text-align:center}
.result-ar{font-size:16px;font-weight:700;color:#34d399}
</style>
</head>
<body>

<div class="app">
  <div class="header">
    <div class="h-left">
      <div class="h-logo">أمير</div>
      <div class="h-title">طريق الأمير</div>
    </div>
    <button class="lang-btn" onclick="toggleMainLang()">ZH</button>
  </div>

  <div class="counter">
    <span>الكبسولات العلمية والتجارية</span>
    <span>المجموع: <b id="total-count">0</b></span>
  </div>

  <div class="content">
    <div class="filters">
      <div class="chip active" onclick="filterCards('all', this)">الكل</div>
      <div class="chip" onclick="filterCards('trade', this)">تجارة</div>
      <div class="chip" onclick="filterCards('shipping', this)">شحن</div>
      <div class="chip" onclick="filterCards('travel', this)">تنقل وتعاملك</div>
    </div>

    <div id="cards-container">
      <!-- الكروت تولد تلقائياً عبر السكريبت -->
    </div>
  </div>
</div>

<script>
// قاعدة البيانات التفاعلية للتطبيق
const vocabulary = [
  { char: "进口", py: "jìn kǒu", en: "Import", ar: "استيراد", desc: "عملية إدخال البضائع والسلع", cat: "trade" },
  { char: "出口", py: "chū kǒu", en: "Export", ar: "تصدير", desc: "شحن البضائع إلى خارج الدولة", cat: "trade" },
  { char: "海运", py: "hǎi yùn", en: "Sea Freight", ar: "شحن بحري", desc: "نقل الحاويات والبضائع عبر السفن", cat: "shipping" },
  { char: "空运", py: "kōng yùn", en: "Air Freight", ar: "شحن جوي", desc: "النقل السريع للبضائع عبر الطائرات", cat: "shipping" },
  { char: "价格", py: "jià gé", en: "Price", ar: "السعر / التكلفة", desc: "قيمة البضاعة المطلوبة", cat: "trade" },
  { char: "工厂", py: "gōng chǎng", en: "Factory", ar: "المصنع", desc: "مكان تصنيع وإنتاج السلع", cat: "trade" },
  { char: "提单", py: "tí dān", en: "Bill of Lading", ar: "بوليصة الشحن", desc: "وثيقة استلام ونقل الشحنة", cat: "shipping" },
  { char: "โรงแรม", py: "jiǔ diàn", en: "Hotel", ar: "فندق", desc: "مقر الإقامة أثناء رحلة التجارة", cat: "travel" }
];

let currentCat = 'all';

// دالة عرض الكروت
function renderCards() {
  const container = document.getElementById('cards-container');
  container.innerHTML = '';

  const filtered = currentCat === 'all' 
    ? vocabulary 
    : vocabulary.filter(item => item.cat === currentCat);

  document.getElementById('total-count').innerText = filtered.length;

  filtered.forEach(item => {
    const cardHTML = `
      <div class="card">
        <div class="learn-top">
          <div>
            <div class="cn-char">${item.char}</div>
            <div class="cn-py">${item.py}</div>
          </div>
          <button class="play-btn" onclick="speakChinese('${item.char}', this)">
            <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          </button>
        </div>
        <div class="lang-grid">
          <div class="lang-box en">
            <span class="lang-label">English</span>
            <div class="lang-val">${item.en}</div>
          </div>
          <div class="lang-box ar">
            <span class="lang-label">العربية</span>
            <div class="lang-val">${item.ar}</div>
          </div>
        </div>
        <div class="result-box">
          <div class="result-ar">${item.desc}</div>
        </div>
      </div>
    `;
    container.innerHTML += cardHTML;
  });
}

// دالة الفلترة
function filterCards(cat, btn) {
  currentCat = cat;
  document.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
  btn.classList.add('active');
  renderCards();
}

// دالة النطق الصوتي باللغة الصينية
function speakChinese(text, btnElement) {
  if ('speechSynthesis' in window) {
    window.speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = 'zh-CN';
    utterance.rate = 0.8; 

    btnElement.classList.add('playing');
    
    utterance.onend = () => {
      btnElement.classList.remove('playing');
    };

    utterance.onerror = () => {
      btnElement.classList.remove('playing');
    };

    window.speechSynthesis.speak(utterance);
  } else {
    alert("عذراً، ميزة النطق الصوتي غير مدعومة في متصفحك.");
  }
}

// تشغيل العرض الابتدائي
renderCards();
</script>
</body>
</html>
